pkgname=libacars
pkgver=2.2.1
pkgrel=1
pkgdesc="A library for decoding various ACARS message payloads"
url="https://github.com/szpajder/libacars"
license=(MIT)
arch=(x86_64)
depends=(zlib libxml2 jansson glibc)
makedepends=(cmake)
source=("https://github.com/szpajder/libacars/archive/v${pkgver}.tar.gz")
sha256sums=('94b1669ce73f085494fb768a02aab8ac0f4e52704759269b9c526637aa6db7d9')

build() {
  cd "${srcdir}"

  cmake -B build \
      -S "${pkgname}-${pkgver}" \
      -Wno-dev \
      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_BUILD_TYPE=None
  cmake --build build
}

package() {
  cd "${srcdir}"

  DESTDIR="${pkgdir}" cmake --install build
}
