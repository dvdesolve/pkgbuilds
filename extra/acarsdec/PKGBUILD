pkgname=acarsdec
pkgver=4.4.1
pkgrel=1
pkgdesc="ACARS SDR decoder"
url="https://github.com/f00b4r0/acarsdec/"
license=(GPL-2.0-only)
arch=(x86_64)
depends=(airspy alsa-lib cjson glibc libacars libsndfile rtl-sdr soapysdr)
makedepends=(cmake)
optdepends=('acarsserv: Store messages in sqlite database')
source=("https://github.com/f00b4r0/acarsdec/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('39a27ea9dd491fe23ca7dba66b69504e2e0251f6ebbb51c392b7a076f53f0250')

build() {
  cd "${pkgname}-${pkgver}"

  mkdir -p build
  cd build
  cmake .. -DRTLSDR=ON -DSOAPYSDR=ON -DAIRSPY=ON -DSNDFILE=ON -DALSA=ON -DLIBACARS=ON -DCJSON=ON
  make
}

package() {
  cd "${pkgname}-${pkgver}"

  install -Dm755 build/acarsdec "${pkgdir}/usr/bin/acarsdec"
}
